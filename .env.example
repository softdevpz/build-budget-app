# --- Database ---
DATABASE_URL="postgresql://budget_app:budget_app_dev@localhost:5432/budget_app?schema=public"

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Auth ---
JWT_SECRET=change_me_in_production
JWT_REFRESH_SECRET=change_me_too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- AWS S3 ---
AWS_REGION=eu-central-1
AWS_S3_BUCKET=build-budget-app-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Mail (Mailpit locally: SMTP on 1025, web UI on http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Build Budget App <no-reply@build-budget-app.local>"

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# --- App ---
API_PORT=4000
WEB_PUBLIC_API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000
