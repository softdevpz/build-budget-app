generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String
  hashedRefreshToken  String?
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?   @unique
  emailVerificationExpiresAt DateTime?
  plan                String   @default("free")
  stripeCustomerId    String?
  createdAt           DateTime @default(now())

  projects            Project[]
  subscription        Subscription?
  projectMemberships  ProjectMember[]
  diaryEntries        DiaryEntry[]
}

model Project {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  name          String
  address       String?
  region        String?
  areaM2        Decimal?
  startDate     DateTime?
  targetBudget  Decimal?
  status        String   @default("in_progress")
  createdAt     DateTime @default(now())

  stages        Stage[]
  expenses      Expense[]
  documents     Document[]
  tasks         TaskItem[]
  reports       Report[]
  members       ProjectMember[]
  diaryEntries  DiaryEntry[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("editor") // "owner" | "editor"
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Stage {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  order         Int
  plannedBudget Decimal?
  status        String   @default("pending")

  expenses      Expense[]
  documents     Document[]
  tasks         TaskItem[]
  diaryEntries  DiaryEntry[]
}

model Expense {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId        String?
  stage          Stage?   @relation(fields: [stageId], references: [id])
  category       String
  amount         Decimal
  currency       String   @default("PLN")
  date           DateTime
  vendor         String?
  description    String?
  invoiceFileUrl String?
  createdAt      DateTime @default(now())
}

model Document {
  id           String      @id @default(uuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId      String?
  stage        Stage?      @relation(fields: [stageId], references: [id])
  diaryEntryId String?
  diaryEntry   DiaryEntry? @relation(fields: [diaryEntryId], references: [id], onDelete: SetNull)
  type         String
  fileUrl      String
  uploadedAt   DateTime    @default(now())
}

model DiaryEntry {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId   String?
  stage     Stage?   @relation(fields: [stageId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  photos    Document[]
}

model TaskItem {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageId   String?
  stage     Stage?   @relation(fields: [stageId], references: [id])
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  remindedAt DateTime?
}

model Report {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  fileUrl     String?
  error       String?
  requestedAt DateTime  @default(now())
  completedAt DateTime?
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id])
  stripeSubscriptionId String   @unique
  plan                 String
  status               String
  currentPeriodEnd     DateTime
}

model BenchmarkStat {
  id            String   @id @default(uuid())
  region        String
  stageCategory String
  avgCostPerM2  Decimal
  sampleSize    Int
  updatedAt     DateTime @updatedAt

  @@unique([region, stageCategory])
}
