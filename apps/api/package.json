{
  "name": "api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/websockets": "^10.4.0",
    "@nestjs/platform-socket.io": "^10.4.0",
    "@prisma/client": "^5.19.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "bcrypt": "^5.1.1",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@aws-sdk/s3-request-presigner": "^3.1125.0",
    "pdfkit": "^0.20.2",
    "nodemailer": "^9.1.1",
    "@nestjs/schedule": "^4.1.2",
    "stripe": "^22.6.1",
    "@nestjs/event-emitter": "^2.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "prisma": "^5.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/node": "^20.14.0",
    "@types/bcrypt": "^5.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/pdfkit": "^0.17.6",
    "@types/nodemailer": "^8.0.1",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.5.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "ts-jest": "^29.4.12",
    "@nestjs/testing": "^10.4.5",
    "supertest": "^7.2.2",
    "@types/supertest": "^7.2.1"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleFileExtensions": ["js", "json", "ts"],
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/*.constants.ts",
      "!**/*.type.ts",
      "!main.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coverageThreshold": {
      "**/auth/auth.service.ts": { "statements": 80, "branches": 80, "functions": 80, "lines": 80 },
      "**/projects/projects.service.ts": { "statements": 80, "branches": 80, "functions": 80, "lines": 80 },
      "**/benchmark/benchmark.service.ts": { "statements": 80, "branches": 80, "functions": 80, "lines": 80 },
      "**/reports/report-pdf.builder.ts": { "statements": 80, "branches": 80, "functions": 80, "lines": 80 }
    }
  }
}
